# Configuración de correo - EJEMPLOS PARA DIFERENTES PROVEEDORES

# Para Gmail:
# 1. Ve a https://myaccount.google.com/security
# 2. Activa "Verificación en 2 pasos"
# 3. Genera una "Contraseña de aplicación"
# 4. Usa esa contraseña abajo (no tu contraseña normal)
# MAIL_USERNAME=tu_correo@gmail.com
# MAIL_PASSWORD=tu_contraseña_de_aplicación_16_caracteres
# MAIL_FROM=tu_correo@gmail.com
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_STARTTLS=True
# MAIL_SSL_TLS=False

# Para Outlook/Hotmail/Live:
# MAIL_USERNAME=tu_correo@outlook.com
# MAIL_PASSWORD=tu_contraseña_normal
# MAIL_FROM=tu_correo@outlook.com
# MAIL_SERVER=smtp-mail.outlook.com
# MAIL_PORT=587
# MAIL_STARTTLS=True
# MAIL_SSL_TLS=False

# Para Yahoo:
# MAIL_USERNAME=tu_correo@yahoo.com
# MAIL_PASSWORD=tu_contraseña_app
# MAIL_FROM=tu_correo@yahoo.com
# MAIL_SERVER=smtp.mail.yahoo.com
# MAIL_PORT=587
# MAIL_STARTTLS=True
# MAIL_SSL_TLS=False

# Configuración actual (cambiar con tus datos reales):
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_app_o_smtp
MAIL_FROM=tu_correo@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# URL base para el enlace de verificación
BASE_URL=http://localhost:8000

# Clave para firmar tokens
SECRET_KEY=cambia-esta-clave-por-una-segura
ACCESS_TOKEN_EXPIRE_MINUTES=1440
